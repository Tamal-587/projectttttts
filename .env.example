# ==============================================================================
# CodeAlpha_TaskFlow Environment Configuration Template
# Duplicate this file as '.env' in backend/ or root to override default settings.
# ==============================================================================

# Django Security & Core
DJANGO_SECRET_KEY=django-insecure-alpha-taskflow-secret-key-change-in-production-78392104
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL Configuration (Set DB_ENGINE=django.db.backends.postgresql to activate)
POSTGRES_DB=taskflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT Authentication Lifespans
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7

# Frontend Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
